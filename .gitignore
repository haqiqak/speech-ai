dist/
build/
*.egg-info/
*.egg
.eggs/

# ── NLTK data (downloaded at runtime, not committed) ─────────────────────────
nltk_data/

# ── SBERT / sentence-transformers + all runtime model/data caches ─────────────
# The SBERT model, torch hub, and NLTK data are downloaded to .cache/ on first
# run.  Do NOT commit — too large and regenerates automatically.
.cache/

# ── Phase 9/9B validator prototype — fine-tuned weights, not source,
# reproducible from eval/r9_train_validator.py / r9b_train_validator.py.
# Do NOT commit.
eval/r9_validator_model/
eval/r9b_validator_model/
eval/r9b_sanity_checkpoints/

